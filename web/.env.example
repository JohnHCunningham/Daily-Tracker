# App URLs
NEXT_PUBLIC_APP_URL=https://app.oneclickcoaching.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPPORT_OVERRIDE_SECRET=your_support_override_secret_for_emergency_takeover

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=One Click Coaching <noreply@oneclickcoaching.com>

# HubSpot OAuth
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_SCOPES=oauth crm.objects.owners.read crm.objects.contacts.read sales-email-read

# Fathom OAuth
FATHOM_CLIENT_ID=your_fathom_client_id
FATHOM_CLIENT_SECRET=your_fathom_client_secret
FATHOM_AUTHORIZATION_URL=your_fathom_authorization_url_from_fathom_oauth_registration

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_MONTHLY=price_monthly
STRIPE_PRICE_ANNUAL=price_annual

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
